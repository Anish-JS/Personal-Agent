{
  "name": "my-agent",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "eval": "pnpm --filter evals run eval",
    "register-agent": "tsx scripts/register-agent.ts",
    "cost-check": "tsx scripts/cost-check.ts",
    "rebuild-style": "tsx -e \"import('./packages/memory/src/style.ts').then(m => m.rebuildWorkingStyleProfile())\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "tsx": "^4.0.0",
    "vitest": "^1.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0"
  }
}
