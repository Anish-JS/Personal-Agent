# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
AGENT_ID=agt_...                        # From scripts/register-agent.ts

# Voyage AI (embeddings — free tier at dash.voyageai.com)
VOYAGE_API_KEY=pa-...

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...               # For Socket Mode
ALLOWED_SLACK_USER_ID=U...             # Your Slack user ID

# Database
DATABASE_URL=postgresql://user:pass@host:5432/myagent

# Grafana Cloud (from your stack connection details)
GRAFANA_OTLP_TOKEN=...                 # Base64 instance:apikey
GRAFANA_LOKI_TOKEN=...
GRAFANA_METRICS_TOKEN=...

# Sentry
SENTRY_DSN=https://...@o0.ingest.sentry.io/...

# OTel Collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # Or Railway internal URL

# App
LOG_LEVEL=info
NODE_ENV=development
PORT=3000

# Cost alert threshold (default $2.00/day)
COST_ALERT_THRESHOLD=2.00

# MCP OAuth (stored in Anthropic vault — NOT in this file)
# GMAIL_MCP_OAUTH_TOKEN  → set in Claude Console
# GCAL_MCP_OAUTH_TOKEN   → set in Claude Console
# NOTION_MCP_OAUTH_TOKEN → set in Claude Console
